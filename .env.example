# ============================================
# Stock Monitor Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env
# ============================================

# --- App Settings ---
LANGUAGE=zh              # zh = 中文, en = English
CHAT_PLATFORM=telegram   # Currently supported: telegram

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- AI API (OpenAI-compatible) ---
# Supports any OpenAI-compatible provider. Examples:
#
# DeepSeek (recommended, cheap & good):
#   AI_BASE_URL=https://api.deepseek.com
#   AI_API_KEY=sk-your-deepseek-key
#   AI_MODEL=deepseek-chat
#
# OpenAI:
#   AI_BASE_URL=                              # leave empty for OpenAI
#   AI_API_KEY=sk-your-openai-key
#   AI_MODEL=gpt-4o-mini
#
# Groq (free tier available):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_API_KEY=gsk_your-groq-key
#   AI_MODEL=llama-3.1-70b-versatile
#
# Ollama (local, free):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama                         # any non-empty string
#   AI_MODEL=llama3
#
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-ai-api-key
AI_MODEL=deepseek-chat

# --- News APIs ---
# At least Finnhub is recommended. Free RSS sources work without keys.
FINNHUB_API_KEY=your-finnhub-key            # https://finnhub.io/register (free: 60 calls/min)
# NEWSAPI_KEY=your-newsapi-key              # https://newsapi.org (free: 100 req/day, often rate-limited)
# ALPHAVANTAGE_API_KEY=your-key             # https://www.alphavantage.co (free: 25 req/day)

# --- Social Media (Optional) ---
# REDDIT_CLIENT_ID=your-reddit-client-id
# REDDIT_CLIENT_SECRET=your-reddit-client-secret
# REDDIT_USER_AGENT=StockMonitor/1.0
# TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# --- Schedule ---
CHECK_INTERVAL_MINUTES=60                   # Fetch + analyze interval
DAILY_SUMMARY_TIME=07:30                    # Auto-push summary (US Eastern Time)
TIMEZONE=America/New_York
BREAKING_NEWS_THRESHOLD=high
